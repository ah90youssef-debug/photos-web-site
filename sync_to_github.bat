@echo off
chcp 65001 >nul
title رفع التعديلات إلى GitHub تلقائياً

cd /d "%~dp0"

echo [1/3] إضافة كافة التغييرات والملفات الجديدة...
git add -A

set /p msg="اكتب وصف التعديل (أو اضغط Enter لكتابة وصف تلقائي): "
if "%msg%"=="" set msg=تحديث تلقائي للملفات

echo [2/3] حفظ التعديلات...
git commit -m "%msg%"

echo [3/3] رفع التعديلات إلى GitHub...
git push origin master

echo.
echo ====================================================
echo  ✅ تم رفع التعديلات بنجاح إلى GitHub!
echo ====================================================
pause
